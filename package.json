{
	"name": "ui-pick",
	"version": "0.0.0",
	"private": true,
	"description": "pick an element in a vite react app and send the change request to a running claude code session",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"bin": {
		"ui-pick-channel": "./dist/channel/bin.mjs"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"test": "vitest run",
		"check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^24.13.6",
		"bippy": "0.6.1",
		"happy-dom": "^20.14.5",
		"modern-screenshot": "4.7.0",
		"react-grab": "0.2.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"vite": ">=8"
	}
}
